PORT=7080
CONTROL_API_DATA_DIR=services/control-api/data
STORE_DRIVER=json
POSTGRES_URL=postgres://vigilai:vigilai@localhost:5432/vigilai
EDGE_OUTBOX_DIR=edge/edge-agent/data/outbox
EVIDENCE_DIR=edge/edge-agent/data/evidence

# Replace in production. Used to hash one-time camera device keys.
DEVICE_KEY_SALT=change-this-device-key-salt

# Optional operator API token. When set, operator requests must use Authorization: Bearer <token>.
OPERATOR_TOKEN=

# Optional alert webhook for HIGH/CRITICAL incidents and commander escalations.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_MIN_SEVERITY=HIGH
ALERT_WEBHOOK_TIMEOUT_MS=5000

# Comma-separated severity SLA in minutes.
INCIDENT_SLA_MINUTES=CRITICAL:5,HIGH:15,MEDIUM:60,LOW:240

# Optional evidence encryption key. Accepted formats: plain passphrase, 64-char hex, or base64:<32-byte-key>.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_RETENTION_DELETE_FILES=true

MAX_JSON_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# Optional real model/runtime adapters. Leave blank for tests and simulated fixtures.
# For RTSP credentials, prefer camera config `streamUriRef: "env:CAMERA_RTSP_URI"` over storing secrets in JSON.
CAMERA_RTSP_URI=
ANPR_PLATE_DETECT_COMMAND=python
ANPR_PLATE_DETECT_ARGS=edge/analytics/python/opencv_plate_detector.py --image {imagePath}
ANPR_PLATE_DETECT_TIMEOUT_MS=30000
ANPR_OCR_COMMAND=python
ANPR_OCR_ARGS=edge/analytics/python/paddleocr_plate_runtime.py --image {imagePath}
ANPR_OCR_TIMEOUT_MS=30000
FACE_DETECT_COMMAND=python
FACE_DETECT_ARGS=edge/vision-runtime/python/opencv_face_runtime.py --image {imagePath}
FACE_DETECT_TIMEOUT_MS=30000
