{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigilai.local/contracts/incident-event.schema.json",
  "title": "IncidentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "incidentId", "cameraId", "zoneId", "type", "severity", "reasonCodes", "captureTime", "evidence"],
  "properties": {
    "schemaVersion": { "const": "incident-event.v1" },
    "eventId": { "type": "string", "minLength": 12 },
    "incidentId": { "type": "string", "minLength": 8 },
    "cameraId": { "type": "string", "minLength": 3 },
    "zoneId": { "type": "string", "minLength": 3 },
    "type": { "enum": ["VIRTUAL_FENCE_INTRUSION", "NIGHT_MOVEMENT", "CAMERA_TAMPER", "SUSPICIOUS_ACTIVITY", "ANPR_CANDIDATE", "FACE_CANDIDATE"] },
    "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "captureTime": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "sha256"],
      "properties": {
        "manifestId": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "keyframeUri": { "type": "string" },
        "clipUri": { "type": "string" }
      }
    }
  }
}
