    "command-ui:start": "node services/control-api/src/server.mjs",
    "unit:test": "node tests/unit/vision-runtime.test.mjs && node tests/unit/evidence-service.test.mjs",
    "integration:test": "node tests/integration/camera-to-incident.mjs && node tests/integration/offline-outbox-replay.mjs",
